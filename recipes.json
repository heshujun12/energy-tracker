   {
    "name": "生菜",
    "amount": "1棵(约150g)，撕碎"
   },
   {
    "name": "姜",
    "amount": "2片"
   },
   {
    "name": "淀粉",
    "amount": "1小勺(腌肉用)"
   },
   {
    "name": "盐",
    "amount": "适量"
   },
   {
    "name": "香油",
    "amount": "几滴"
   }
