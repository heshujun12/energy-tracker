[
  {
    "id": "tomato-beef",
    "name": "番茄牛腩土豆",
    "emoji": "🍅",
    "color": "#f97316",
    "servings": 4,
    "perServing": {
      "cal": 240,
      "p": 10,
      "c": 12.5,
      "f": 15
    },
    "tags": [
      "高蛋白",
      "下饭",
      "家宴",
      "炖菜",
      "老人小孩友好"
    ],
    "ingredients": [
      {
        "name": "牛腩",
        "amount": "500g，切3cm块"
      },
      {
        "name": "番茄",
        "amount": "4个(约600g)，切块"
      },
      {
        "name": "土豆",
        "amount": "2个(约300g)，切滚刀块"
      },
      {
        "name": "洋葱",
        "amount": "半个，切丝"
      },
      {
        "name": "姜片",
        "amount": "3片"
      },
      {
        "name": "冠农番茄小丁",
        "amount": "1袋(200g)，可省番茄酱"
      },
      {
        "name": "料酒",
        "amount": "1勺(焯水用)"
      },
      {
        "name": "盐/糖",
        "amount": "适量"
      },
      {
        "name": "食用油",
        "amount": "15g"
      }
    ],
    "steps": [
      "牛腩切3cm块，冷水下锅，加1勺料酒，大火煮沸撇去浮沫，捞出温水冲洗干净",
      "番茄顶部划十字，开水烫30秒去皮，切小块；土豆切滚刀块；洋葱切丝",
      "锅中放油，中火下洋葱丝和姜片炒出香味，下牛腩块翻炒至表面微黄",
      "加入番茄块，中小火翻炒3-4分钟，用铲子压出番茄沙",
      "倒入1袋冠农番茄小丁，加热水没过食材约2cm，大火烧开",
      "转小火加盖炖1小时，期间偶尔翻动防止粘底",
      "加入土豆块，继续炖20分钟至土豆软烂",
      "加盐和少许糖调味，大火收汁到汤汁浓稠即可"
    ],
    "note": "一次做4人份，可分装冷冻。番茄小丁代替番茄酱，味道更自然。配米饭吃，汤汁拌饭一绝。",
    "image": "assets/tomato-beef.jpg"
  },
  {
    "id": "chicken-mushroom-congee",
    "name": "鸡小胸香菇生菜粥",
    "emoji": "🥣",
    "color": "#84cc16",
    "servings": 3,
    "perServing": {
      "cal": 280,
      "p": 26,
      "c": 34,
      "f": 3.5
    },
    "tags": [
      "高蛋白",
      "低脂",
      "早餐",
      "养胃",
      "电饭煲",
      "感冒恢复期"
    ],
    "ingredients": [
      {
        "name": "大米",
        "amount": "120g(约量杯1杯)，淘洗干净"
      },
      {
        "name": "水",
        "amount": "1200ml(米水比约1:10)"
      },
      {
        "name": "鸡小胸",
        "amount": "300g，切小丁"
      },
      {
        "name": "鲜香菇",
        "amount": "4-5朵(约100g)，切丁"
      },
      {
        "name": "生菜",
        "amount": "1棵(约150g)，撕碎"
      },
      {
        "name": "姜",
        "amount": "2片"
      },
      {
        "name": "淀粉",
        "amount": "1小勺(腌肉用)"
      },
      {
        "name": "盐",
        "amount": "适量"
      },
      {
        "name": "香油",
        "amount": "几滴"
      }
    ],
    "steps": [
      "大米淘洗干净，加1200ml水和2片姜，倒入电饭煲选煮粥模式启动",
      "鸡小胸切1cm小丁，加少许盐、1小勺淀粉抓匀，腌10分钟",
      "香菇洗净切丁；生菜洗净撕碎备用",
      "电饭煲煮粥还剩20分钟时，开盖放入香菇丁，搅一下继续煮",
      "还剩8分钟时，放入腌好的鸡小胸丁，用筷子搅散避免结块",
      "还剩2分钟时，放入撕碎的生菜，搅一下盖盖继续",
      "电饭煲跳到保温后，加盐调味，滴几滴香油，搅拌均匀即可出锅"
    ],
    "note": "电饭煲煮粥不用看火。关键：鸡肉别太早放会老，生菜最后放才绿。适合感冒恢复期或早餐。想早上喝就前一晚米+水放好预约。",
    "image": "assets/chicken-congee.jpg"
  },
  {
    "id": "tomato-basa",
