[
  {
    "id": "tomato-beef",
    "name": "番茄牛腩土豆",
    "emoji": "🍅",
    "color": "#f97316",
    "servings": 4,
    "perServing": {
      "cal": 240,
      "p": 10,
      "c": 12.5,
      "f": 15
    },
    "tags": [
      "高蛋白",
      "下饭",
      "家宴"
    ],
    "ingredients": [
      {
        "name": "牛腩",
        "amount": "500g"
      },
      {
        "name": "番茄",
        "amount": "4个(约600g)"
      },
      {
        "name": "土豆",
        "amount": "2个(约300g)"
      },
      {
        "name": "洋葱",
        "amount": "半个"
      },
      {
        "name": "姜片",
        "amount": "3片"
      },
      {
        "name": "番茄酱",
        "amount": "2勺"
      },
      {
        "name": "盐/糖/油",
        "amount": "适量"
      }
    ],
    "steps": [
      "牛腩切块，冷水下锅焯水，撇去浮沫捞出",
      "番茄切块，土豆切块，洋葱切丝",
      "锅中放油，炒香洋葱和姜片，下牛腩翻炒至表面微黄",
      "加入番茄块炒出汁，加番茄酱2勺炒匀",
      "加热水没过食材，大火烧开转小火炖1小时",
      "加入土豆块，继续炖20分钟至土豆软烂",
      "加盐和少许糖调味，收汁即可"
    ],
    "note": "一次做4份，分装冷冻。吃的时候配一碗米饭，营养均衡。"
  },
  {
    "id": "chicken-mushroom-congee",
    "name": "鸡小胸香菇生菜粥",
    "emoji": "🥣",
    "color": "#84cc16",
    "servings": 3,
    "perServing": {
      "cal": 280,
      "p": 26,
      "c": 34,
      "f": 3.5
    },
    "tags": [
      "高蛋白",
      "低脂",
      "早餐",
      "养胃",
      "电饭煲"
    ],
    "ingredients": [
      {
        "name": "大米",
        "amount": "120g(约量杯1杯)"
      },
      {
        "name": "鸡小胸",
        "amount": "300g"
      },
      {
        "name": "鲜香菇",
        "amount": "4-5朵(约100g)"
      },
      {
        "name": "生菜",
        "amount": "1棵(约150g)"
      },
      {
        "name": "姜",
        "amount": "2片"
      },
      {
        "name": "淀粉",
        "amount": "1小勺"
      },
      {
        "name": "盐/香油",
        "amount": "适量"
      }
    ],
    "steps": [
      "大米淘洗干净，加1200ml水和姜片，倒入电饭煲选煮粥模式",
      "鸡小胸切小丁，加少许盐和1小勺淀粉抓匀腌10分钟",
      "香菇切丁，生菜撕碎备用",
      "煮粥还剩20分钟时，开盖放入香菇丁搅匀",
      "还剩8分钟时，放入鸡肉丁用筷子搅散",
      "还剩2分钟时，放入生菜烫一下",
      "跳到保温后加盐调味，滴几滴香油即可"
    ],
    "note": "电饭煲煮粥不用看火。鸡肉别太早放会老，生菜最后放才绿。适合感冒恢复期或早餐。"
  },
  {
    "id": "tomato-basa",
    "name": "番茄巴沙鱼",
    "emoji": "🐟",
    "color": "#0ea5e9",
    "servings": 4,
    "perServing": {
      "cal": 195,
      "p": 22,
      "c": 6,
      "f": 7
    },
    "tags": [
      "高蛋白",
      "低脂",
      "小孩友好",
      "无刺",
      "晚餐"
    ],
    "ingredients": [
      {
        "name": "巴沙鱼柳",
        "amount": "600g"
      },
      {
        "name": "番茄",
        "amount": "4个(约400g)"
      },
      {
        "name": "姜片",
        "amount": "3片"
      },
      {
        "name": "番茄酱",
        "amount": "1勺"
      },
      {
        "name": "盐/糖",
        "amount": "适量"
      },
      {
        "name": "油",
        "amount": "10g"
      }
    ],
    "steps": [
      "巴沙鱼解冻切大块，用厨房纸吸干水分，少许盐腌10分钟",
      "番茄顶部划十字，开水烫去皮，切块",
      "锅中放油，下姜片爆香，加入番茄块炒出沙",
      "加1勺番茄酱和少许糖，加热水煮开",
      "放入巴沙鱼块，中火煮5-8分钟至鱼肉变白",
      "加盐调味，撒葱花即可"
    ],
    "note": "无刺无骨，小孩能直接吃。番茄汤汁拌饭很好。别煮太久，鱼肉老了柴。"
  },
  {
    "id": "airfryer-potato-pancake",
    "name": "空气炸锅土豆丝蛋饼",
    "emoji": "🥔",
    "color": "#eab308",
    "servings": 4,
    "perServing": {
      "cal": 140,
      "p": 4,
      "c": 20,
      "f": 4
    },
    "tags": [
      "空气炸锅",
      "主食",
      "小孩友好",
      "晚餐"
    ],
    "ingredients": [
      {
        "name": "土豆",
        "amount": "280g"
      },
      {
        "name": "鸡蛋",
        "amount": "2个"
      },
      {
        "name": "面粉",
        "amount": "2勺(约30g)"
      },
      {
        "name": "盐/黑胡椒",
        "amount": "适量"
      },
      {
        "name": "油",
        "amount": "5g"
      }
    ],
    "steps": [
      "土豆切丝，用清水泡一下再挤干水分",
      "土豆丝加鸡蛋、面粉、盐、黑胡椒搅匀",
      "空气炸锅篮刷薄油，把混合物平铺成一层",
      "180°C烤15分钟，中途翻面一次",
      "表面刷少许油，烤到边缘金黄酥脆即可"
    ],
    "note": "土豆丝一定要挤干水，不然烤不熟。切厚一点外脆里软。小孩能吃，蛋融在饼里。"
  },
  {
    "id": "blanched-greens",
    "name": "白灼生菜/娃娃菜",
    "emoji": "🥬",
    "color": "#22c55e",
    "servings": 4,
    "perServing": {
      "cal": 25,
      "p": 1.5,
      "c": 3,
      "f": 1
    },
    "tags": [
      "低脂",
      "素菜",
      "快手",
      "晚餐"
    ],
    "ingredients": [
      {
        "name": "生菜/娃娃菜",
        "amount": "400g"
      },
      {
        "name": "蒜末",
        "amount": "3瓣"
      },
      {
        "name": "生抽",
        "amount": "1勺"
      },
      {
        "name": "香油",
        "amount": "几滴"
      }
    ],
    "steps": [
      "水烧开，加几滴油和少许盐",
      "放入生菜/娃娃菜烫1-2分钟捞出摆盘",
      "蒜末撒在菜上，淋一勺生抽",
      "锅烧热油浇在蒜末上，滴几滴香油即可"
    ],
    "note": "3分钟搞定。娃娃菜更甜，生菜更脆。补充纤维和维生素。"
  }
