[
  {
    "id": "tomato-beef",
    "name": "番茄牛腩土豆",
    "emoji": "🍅",
    "color": "#f97316",
    "image": "assets/tomato-beef.jpg",
    "ingredientImage": null,
    "servings": 4,
    "perServing": {"cal": 240, "p": 10, "c": 12.5, "f": 15},
    "tags": ["高蛋白", "下饭", "家宴"],
    "ingredients": [
      {"name": "牛腩", "amount": "500g"},
      {"name": "番茄", "amount": "4个"},
      {"name": "土豆", "amount": "2个"},
      {"name": "洋葱", "amount": "半个"},
      {"name": "姜片", "amount": "3片"},
      {"name": "番茄酱", "amount": "2勺"},
      {"name": "盐/糖/油", "amount": "适量"}
    ],
    "steps": [
      {"text": "牛腩切块冷水下锅焯水，撇沫捞出", "img": "assets/tb-step1.jpg"},
      {"text": "番茄土豆切块，洋葱切丝", "img": "assets/tb-step2.jpg"},
      {"text": "热油炒香洋葱姜片，下牛腩煎至微黄", "img": "assets/tb-step3.jpg"},
      {"text": "加番茄块炒出红汁，放2勺番茄酱", "img": "assets/tb-step4.jpg"},
      {"text": "加热水没过，大火烧开转小火炖1小时", "img": "assets/tb-step5.jpg"},
      {"text": "加土豆块继续炖20分钟至软烂", "img": "assets/tb-step6.jpg"},
      {"text": "加盐糖调味，大火收汁撒葱花", "img": "assets/tb-step7.jpg"}
    ],
    "note": "一次做4份分装冷冻，吃时配一碗米饭，营养均衡。"
  },
