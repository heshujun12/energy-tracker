  {
    "id": "tomato-basa",
    "name": "番茄巴沙鱼",
    "emoji": "🐟",
    "color": "#0ea5e9",
    "servings": 4,
    "perServing": {
      "cal": 195,
      "p": 22,
      "c": 12,
      "f": 4.5
    },
    "tags": [
      "晚餐",
      "高蛋白",
      "低脂",
      "无刺",
      "老人小孩友好",
      "感冒恢复期"
    ],
    "ingredients": [
      {
        "name": "巴沙鱼柳",
        "amount": "600g"
      },
      {
        "name": "冠农番茄小丁(200g/袋)",
        "amount": "1袋"
      },
      {
        "name": "新鲜番茄",
        "amount": "200g(约2个中等)"
      },
      {
        "name": "姜片",
        "amount": "3片"
      },
      {
        "name": "食用油",
        "amount": "10g"
      },
      {
        "name": "白糖",
        "amount": "少许(按需)"
      },
      {
        "name": "盐",
        "amount": "适量"
      }
    ],
    "steps": [
      "巴沙鱼解冻切大块，厨房纸吸干水分，少许盐腌10分钟",
      "新鲜番茄切块；冠农番茄小丁开袋备用",
      "锅中倒油，姜片爆香，倒入新鲜番茄中小火炒软出沙",
      "倒入整袋冠农番茄小丁翻炒1分钟，加热水煮开，少许糖微调酸甜",
      "放入巴沙鱼块，中火煮5-8分钟至鱼肉变白，别久煮",
      "尝味补盐，撒葱花出锅"
    ],
    "note": "冠农番茄小丁免洗免切，番茄风味浓，可省番茄酱；无新鲜番茄就用2袋(400g)替代。巴沙鱼无刺，老人小孩都能吃。"
  },
