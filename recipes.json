    "id": "airfryer-potato-pancake",
    "name": "空气炸锅土豆丝蛋饼",
    "emoji": "🥔",
    "color": "#eab308",
    "servings": 4,
    "perServing": {
      "cal": 140,
      "p": 4,
      "c": 20,
      "f": 4
    },
    "tags": [
      "空气炸锅",
      "主食",
      "小孩友好",
      "晚餐"
    ],
    "ingredients": [
      {
        "name": "土豆",
        "amount": "250g"
      },
      {
        "name": "鸡蛋",
        "amount": "2个(约100g)"
      },
      {
        "name": "面粉",
        "amount": "1大勺(约20g)"
      },
      {
        "name": "盐/黑胡椒",
        "amount": "适量"
      },
      {
        "name": "油",
        "amount": "刷薄层约5g"
      }
    ],
    "steps": [
      "土豆切细丝，清水泡2分钟后彻底挤干水分",
      "土豆丝加鸡蛋、面粉、盐、黑胡椒搅匀",
      "炸篮铺烘焙纸刷薄油，混合物平铺成1cm厚一层",
      "空气炸锅180°C烤15分钟，第8分钟翻面一次",
      "表面刷薄油，烤到边缘金黄、筷子能戳透即可"
    ],
    "note": "土豆丝一定要挤干水，不然烤不熟。蛋融在饼里，小孩能吃。"
  },
