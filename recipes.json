    "tags": [
      "空气炸锅",
      "主食",
      "小孩友好",
      "晚餐"
    ],
    "ingredients": [
      {
        "name": "土豆",
        "amount": "250g，切细丝"
      },
      {
        "name": "鸡蛋",
        "amount": "2个(约100g)"
      },
      {
        "name": "面粉",
        "amount": "1大勺(约20g)"
      },
      {
        "name": "盐",
        "amount": "半小勺"
      },
      {
        "name": "黑胡椒",
        "amount": "少许"
      },
      {
        "name": "食用油",
        "amount": "刷薄层约5g"
      }
    ],
    "steps": [
      "土豆去皮切细丝，放清水里泡2分钟去掉淀粉",
      "捞出土豆丝，用手或厨房纸彻底挤干水分(关键！不然烤不熟)",
      "土豆丝打入2个鸡蛋，加1大勺面粉、盐、黑胡椒，搅匀",
      "空气炸锅篮铺烘焙纸，刷薄油，把混合物均匀铺成约1cm厚一层",
      "180°C烤8分钟后拉出，翻面，表面刷薄油",
      "继续烤7-8分钟，至边缘金黄酥脆、筷子能轻松戳透即可",
      "取出切三角块装盘"
    ],
    "note": "土豆丝一定要挤干水，这是外脆里软的关键。蛋融在饼里，小孩能吃。配番茄巴沙鱼的汤汁蘸着吃更香。",
    "image": "assets/potato-pancake.jpg"
  },
