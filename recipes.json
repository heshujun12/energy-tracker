[
 {
  "id": "tomato-beef",
  "name": "番茄牛腩土豆",
  "emoji": "🍅",
  "color": "#f97316",
  "servings": 4,
  "perServing": {
   "cal": 240,
   "p": 10,
   "c": 12.5,
   "f": 15,
   "fiber": 3.0,
   "sodium": 600
  },
  "tags": [
   "高蛋白",
   "下饭",
   "家宴",
   "炖菜",
   "老人小孩友好"
  ],
  "ingredients": [
   {
    "name": "牛腩",
    "amount": "500g，切3cm块"
   },
   {
    "name": "番茄",
    "amount": "4个(约600g)，切块"
   },
   {
    "name": "土豆",
    "amount": "2个(约300g)，切滚刀块"
   },
   {
    "name": "洋葱",
    "amount": "半个，切丝"
   },
   {
    "name": "姜片",
    "amount": "3片"
   },
   {
    "name": "冠农番茄小丁",
    "amount": "1袋(200g)，可省番茄酱"
   },
   {
    "name": "料酒",
    "amount": "1勺(焯水用)"
   },
   {
    "name": "盐/糖",
    "amount": "适量"
   },
   {
    "name": "食用油",
    "amount": "15g"
   }
  ],
  "steps": [
   "牛腩切3cm块，冷水下锅，加1勺料酒，大火煮沸撇去浮沫，捞出温水冲洗干净",
   "番茄顶部划十字，开水烫30秒去皮，切小块；土豆切滚刀块；洋葱切丝",
   "锅中放油，中火下洋葱丝和姜片炒出香味，下牛腩块翻炒至表面微黄",
   "加入番茄块，中小火翻炒3-4分钟，用铲子压出番茄沙",
   "倒入1袋冠农番茄小丁，加热水没过食材约2cm，大火烧开",
   "转小火加盖炖1小时，期间偶尔翻动防止粘底",
   "加入土豆块，继续炖20分钟至土豆软烂",
   "加盐和少许糖调味，大火收汁到汤汁浓稠即可"
  ],
  "note": "一次做4人份，可分装冷冻。番茄小丁代替番茄酱，味道更自然。配米饭吃，汤汁拌饭一绝。",
  "image": "assets/tomato-beef.jpg"
 },
 {
