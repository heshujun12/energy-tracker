[
  {
    "id": "tomato-beef",
    "name": "番茄牛腩土豆",
    "emoji": "🍅",
    "color": "#f97316",
    "image": "assets/tomato-beef.jpg",
    "servings": 4,
    "perServing": {"cal": 240, "p": 10, "c": 12.5, "f": 15},
    "tags": ["高蛋白", "下饭", "家宴"],
    "ingredients": [
      {"name": "牛腩", "amount": "500g"},
      {"name": "番茄", "amount": "4个(约600g)"},
      {"name": "土豆", "amount": "2个(约300g)"},
      {"name": "洋葱", "amount": "半个"},
      {"name": "姜片", "amount": "3片"},
      {"name": "番茄酱", "amount": "2勺"},
      {"name": "盐/糖/油", "amount": "适量"}
    ],
    "steps": [
      "牛腩切块，冷水下锅焯水，撇去浮沫捞出",
      "番茄切块，土豆切块，洋葱切丝",
      "锅中放油，炒香洋葱和姜片，下牛腩翻炒至表面微黄",
      "加入番茄块炒出汁，加番茄酱2勺炒匀",
      "加热水没过食材，大火烧开转小火炖1小时",
      "加入土豆块，继续炖20分钟至土豆软烂",
      "加盐和少许糖调味，收汁即可"
    ],
    "note": "一次做4份，分装冷冻。吃的时候配一碗米饭，营养均衡。"
  },
  {
    "id": "chicken-mushroom-congee",
    "name": "鸡小胸香菇生菜粥",
    "emoji": "🥣",
    "color": "#84cc16",
    "image": "assets/chicken-congee.jpg",
    "servings": 3,
    "perServing": {"cal": 280, "p": 26, "c": 34, "f": 3.5},
    "tags": ["高蛋白", "早餐", "养胃"],
    "ingredients": [
      {"name": "鸡小胸", "amount": "200g"},
      {"name": "大米", "amount": "100g(生重)"},
      {"name": "干香菇", "amount": "6朵"},
      {"name": "生菜", "amount": "100g"},
      {"name": "姜丝", "amount": "5g"},
      {"name": "盐/香油", "amount": "适量"}
    ],
    "steps": [
      "大米淘洗后加水煮成粥底（约40分钟）",
      "鸡小胸切丁，用少许盐和姜丝腌制10分钟",
      "干香菇泡发后切小丁",
      "粥底煮稠后下鸡丁和香菇丁，搅散煮5分钟",
      "最后下生菜丝，加盐和几滴香油调味即可"
    ],
    "note": "三人份。鸡胸肉嫩不柴，生菜最后放保持翠绿。"
  }
]
