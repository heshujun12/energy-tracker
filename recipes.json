      },
      {
        "name": "鲜香菇",
        "amount": "4-5朵(约100g)"
      },
      {
        "name": "生菜",
        "amount": "1棵(约150g)"
      },
      {
        "name": "姜",
        "amount": "2片"
      },
      {
        "name": "淀粉",
        "amount": "1小勺"
      },
      {
        "name": "盐/香油",
        "amount": "适量"
      }
    ],
    "steps": [
      "大米淘洗干净，加1200ml水和姜片，倒入电饭煲选煮粥模式",
      "鸡小胸切小丁，加少许盐和1小勺淀粉抓匀腌10分钟",
      "香菇切丁，生菜撕碎备用",
      "煮粥还剩20分钟时，开盖放入香菇丁搅匀",
      "还剩8分钟时，放入鸡肉丁用筷子搅散",
      "还剩2分钟时，放入生菜烫一下",
      "跳到保温后加盐调味，滴几滴香油即可"
